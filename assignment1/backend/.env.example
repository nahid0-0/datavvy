# Copy to .env and fill in. .env is git-ignored.

# --- TiDB Cloud (MySQL compatible, TLS required) ---
DB_URL=jdbc:mysql://<HOST>:4000/vms?sslMode=VERIFY_IDENTITY&createDatabaseIfNotExist=true
DB_USERNAME=<PREFIX>.root
DB_PASSWORD=<PASSWORD>

# --- Local PostgreSQL alternative ---
# DB_URL=jdbc:postgresql://localhost:5432/vms
# DB_USERNAME=vms
# DB_PASSWORD=vms
